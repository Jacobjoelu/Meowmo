<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meowmo Notes</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body class="bg-neutral-900">
    <div class="nav"></div>
    <div class="flex justify-between text-white p-6">
      <h1>Welcome to Meowmo</h1>
      <button class="border border-white rounded-full overflow-hidden">
        <img
          src="./cat-image.jpg"
          class="w-8 h-8 object-cover"
          alt="profile-image"
        />
      </button>
    </div>

    <!-- main notes -->
    <div class="container text-white px-4 mx-auto">
      <!-- notes input -->
      <div
        class="flex flex-col mt-2 mb-6 mx-auto w-full max-w-lg rounded-lg border border-neutral-600 shadow-lg shadow-neutral-900"
      >
        <!-- default input -->
        <input
          id="defaultInput"
          type="text"
          placeholder="Take a note..."
          class="flex-1 px-3 py-2.5 bg-transparent border-none outline-none placeholder:text-neutral-400"
        />

        <%#-- note input after click --%> <%- include('makenote')%>
      </div>

      <%#-- notes container (column-layout instead of grid) %>
      <div
        class="columns-2 md:columns-3 lg:columns-4 xl:columns-5 gap-4 mt-8 lg:px-12"
      >
        <%- include('note', { notes: notes }) %>
      </div>
    </div>

    <script src="./main.js"></script>
  </body>
</html>
