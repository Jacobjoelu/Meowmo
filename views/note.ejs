<% if (notes && notes.length > 0) { %> <% notes.forEach(({ _id, title, content
}) => { %>
<div
  class="group border border-neutral-600 rounded-lg overflow-hidden pb-3 mb-4"
>
  <%# Note title section %>
  <div class="flex justify-between items-start px-4 pt-3 font-semibold">
    <p id="title-<%= _id %>"><%= title %></p>
  </div>

  <%# Note content section with fallback %>
  <div
    class="px-4 pt-2.5 mb-3 text-sm break-words max-h-[192px] md:max-h-[430px] overflow-hidden"
  >
    <%= content %>
  </div>

  <%# Edit and Delete buttons section %>
  <div class="flex justify-end px-3 h-6">
    <button
      data-id="<%= _id %>"
      class="edit hidden group-hover:block px-3 bg-transparent border-none outline-none"
    >
      Edit
    </button>
    <button
      data-id="<%= _id %>"
      class="delete hidden group-hover:block bg-transparent border-none outline-none"
    >
      Delete
    </button>
  </div>
</div>
<% }); %> <% } else { %>
<p class="text-neutral-400">No notes to display.</p>
<% } %> 