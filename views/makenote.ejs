<form
  id="note-form"
  method="post"
  class="takeNote hidden"
  action="/api/makenote"
>
  <input
    id="noteTitleInput"
    name="title"
    type="text"
    placeholder="Title"
    class="w-full px-3.5 py-2.5 bg-transparent border-none outline-none placeholder:text-neutral-400"
  />
  <div>
    <textarea
      name="content"
      id="noteContentInput"
      class="w-full px-3.5 py-2.5 text-sm bg-transparent border-none outline-none placeholder:text-neutral-400 resize-none overflow-hidden"
      placeholder="Take a note..."
    ></textarea>
    <div class="flex justify-end pb-2 px-4">
      <button
        type="submit"
        id="closeInputBtn"
        class="text-xs text-neutral-300 bg-neutral-800 px-4 py-1.5 rounded-md hover:bg-neutral-700"
      >
        Close
      </button>
    </div>
  </div>
</form>
